<?xml version="1.0" encoding="utf-8"?>
<!--
  启动器图标单色层（Android 13+ 主题图标 / Material You 桌面取形）。

  主题化桌面会把本层用系统色重新着色，因此这里必须是**单色、无渐变、无透明叠加**的纯形状，
  否则会出现「彩色图标 / 单色图标」两套观感。形状与 ic_launcher_foreground.xml 完全一致
  （取景框 + 对焦点 + 对勾），只换颜色：前景层用白/霓虹（压在深空蓝背景上），
  本层统一用黑（由系统着色）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

