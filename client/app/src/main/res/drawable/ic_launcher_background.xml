<?xml version="1.0" encoding="utf-8"?>
<!--
  启动器图标背景层（品牌版 · 薄荷绿渐变）。

  设计语言：
  - 品牌色采样自落地页 server/public/index.html 的 brand-mint 变量 #57E08E
    与 Color.kt 的 Brand50 #1D7C43（界面主色唯一事实源）；
  - 纵向两段渐变 #57E08E → #2FA968：顶部对齐官网图标的亮薄荷，
    底部压暗一档以保住白色剪影的对比度（纯亮薄荷上白剪影只有 1.7:1）；
  - 不保留电路网格纹理：标识是扁平单色剪影，网格会与它争夺注意力。

  前景层为 drawable-nodpi/ic_launcher_foreground_logo.png（白色剪影），
  由 2048px 设计源图按 108dp 画布的 60% 安全区提取，边缘带抗锯齿 alpha。
  改品牌色请改本文件的 gradient item，不要回 values/colors.xml 加同名颜色
  （该处只保留被引用的资源色，避免第二份真相）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108">
                <item android:offset="0" android:color="#57E08E" />
                <item android:offset="1" android:color="#2FA968" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
