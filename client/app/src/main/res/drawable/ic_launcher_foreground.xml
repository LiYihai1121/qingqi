<?xml version="1.0" encoding="utf-8"?>
<!--
  启动器图标前景层（108dp 画布，坐标系与 Android 自适应图标一致）。

  设计要点（改动前请先读，避免退化成通用「快进」图形）：
  - 安全区 66dp（21..87）、可视区 72dp（18..90）。盾牌轮廓（28..80）落在安全区内；
  - 圆盘 + 负空间「跳过」箭头：负空间在小尺寸下对比度最高，48dp 与磁贴 24dp 仍可辨识，
    而实心描边方案在 24px 会糊成一团；
  - 箭头必须**完全位于盾牌内**：evenOdd 填充下「在槽内但在盾牌外」的点会重新被填上，
    负空间消失。因此闪电负空间完全位于盾牌内，不再向外穿出；
  - 单色层见 ic_launcher_monochrome.xml（Android 13+ 主题图标）。

  预览与本文件使用同一组坐标：渲染脚本输出即为此处的 pathData。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 盾牌 + 负空间闪电合并为一条 evenOdd 路径 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,13 L80,24 L78,52 C76,68 66,81 54,90 C42,81 32,68 30,52 L28,24 Z
                          M59,28 L43,52 L53,52 L48,72 L67,45 L56,45 Z" />
</vector>
