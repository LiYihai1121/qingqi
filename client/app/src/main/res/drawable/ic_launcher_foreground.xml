<?xml version="1.0" encoding="utf-8"?>
<!--
  启动器图标前景层（108dp 画布，坐标系与 Android 自适应图标一致）。

  2026-10 图标改版（科技感方向，舍弃旧「圆盘 + 负空间箭头」的全部箭头母题）：
  母题是「HUD 取景框 + 霓虹对勾」——取景框与对焦点指代无障碍服务对界面节点的
  自动扫描，对勾指代「这个开屏已被自动跳过」，与产品的「自动识别 → 自动跳过」
  链路一一对应，且不依赖任何箭头元素。要点：
  - 安全区 66dp（21..87）：取景框四角 (32.5,32.5) 径向距离 √(21.5²×2) ≈ 30.4，
    加 3.4 描边外沿 ≈ 32.8 ≤ 33；对勾最远点 (70,42.5) 径向 ≈ 19.7。整个剪影
    收在安全区内，任何遮罩（圆 / 方圆 / 圆角方）都不会切角；
  - 对勾用**圆头描边 + 霓虹渐变**（青 #2DE1FC → 蓝 #2E7CF6，沿书写方向）：
    深空底上渐变实笔才有「识别完成」的能量感；负空间方案在深底上对比不足；
  - 对焦点（上下边中点）用实心圆点补足「正在对焦」的细节，层级低于取景框。

  单色层见 ic_launcher_monochrome.xml（Android 13+ 主题图标），形状与本层一致。

  预览与本文件使用同一组坐标：离线渲染脚本的输出即为此处的 pathData。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- HUD 取景框：四角臂长 10，描边 3.4，直角斜接 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.4"
        android:pathData="M32.5,42.5 V32.5 H42.5 M65.5,32.5 H75.5 V42.5 M75.5,65.5 V75.5 H65.5 M42.5,75.5 H32.5 V65.5" />

    <!-- 对焦点：上下边中点，实心圆点 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M51.8,32.5 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 Z
                          M51.8,75.5 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 Z" />

    <!-- 对勾：圆头描边 + 霓虹渐变（青→蓝，沿书写方向） -->
    <path
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M40,55.5 L50.5,66 L70,42.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="40"
                android:startY="60"
                android:endX="70"
                android:endY="42">
                <item android:offset="0" android:color="#2DE1FC" />
                <item android:offset="1" android:color="#2E7CF6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
