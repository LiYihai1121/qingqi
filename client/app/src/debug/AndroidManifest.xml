<?xml version="1.0" encoding="utf-8"?>
<!-- 仅 debug 变体：追加真机验证辅助的规则种子接收器（不进 release）。
     exported=true 是有意为之——只接受 adb shell am broadcast（shell 身份），
     debug 构建不用于生产，且接收器无副作用（仅写入本应用规则存储）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.qingqi.adskip.debug.SeedRulesReceiver"
            android:exported="true" />
    </application>
</manifest>
