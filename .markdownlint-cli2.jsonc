// Markdown 静态检查——本文件是「文档长什么样」的机器可读事实源。
//
// 为什么用 .markdownlint-cli2.jsonc 而不是 .markdownlint.json：cli2 格式同时被
//   - 命令行 / CI（markdownlint-cli2 直接读本文件，含 globs 与 ignores）；
//   - VS Code 的 markdownlint 扩展（0.62.1 起按 cli2 配置解析，优先级高于 .markdownlint.*）；
// 一处配置两个消费者，避免「编辑器绿的、CI 红的」这种第二份真相。
//
// 定位：本检查**不是**格式洁癖，只拦「会改变渲染结果或读者看到错内容」的问题——
// 标题层级断裂（MD001/MD003）、围栏缺语言（MD040）、表格列数不齐（MD056）、
// 列表/标题/围栏缺空行导致结构粘连（MD022/MD031/MD032）、文件末尾无换行（MD047）、
// 重复标题与失效锚点（MD024/MD051）等。
//
// 基线（2026-10-29 实测，66 份 .md）：默认规则下 1759 条告警，其中 5 条规则占了 1691 条
// 且全部属于「中文文风」或「纯观感」——逐条改只会得到一份几百行的排版 diff，
// 换不来任何渲染正确性。这 5 条在下文逐条关闭并写明证据、以及「什么条件下可以打开」。
// 关闭后基线 83 条，已全部按真实缺陷修掉（标题补空行、围栏补语言、表格列数、
// 6 个 SKILL.md 补一级标题等），因此本配置在当前语料上是零告警。
//
// 变更方式：新增例外必须在本文件写明「为什么这条规则在本仓库不适用」并给出实测数量，
// 不允许在单文件里用 <!-- markdownlint-disable --> 掩盖问题——那是把检查关掉，
// 不是解决检查（同 .editorconfig 对 ktlint-disable 的立场）。

{
  // 只检查 .md；.mdx（服务端 node_modules 内的构建产物）与无扩展名法律文本
  // （LICENSE、DCO）不在范围内。LICENSE 另由 .vscode/settings.json 的
  // files.associations 钉为 plaintext——扩展是按 languageId 而非 glob 决定是否 lint 的。
  "globs": ["**/*.md"],

  // 与根 .gitignore / .vscode/settings.json 的 files.exclude 同源：
  // Agent 工作区与构建产物里存在整仓副本，不排除会让同一份文档被检查两次、
  // 且报错路径指向副本（改了主检出却不消失），属典型的「双重真相」。
  "ignores": [
    "**/node_modules/**",
    "client/build/**",
    "server/data/**",
    ".worktrees/**",
    ".agents/**",
    ".kilo/**",
    ".kilocode/**",
    ".mimosa/**",
    ".workbuddy/**",
    ".workbuddy-ai/**",
    ".cursor/**",
    ".dsh/**",
    ".dsh-acl-recovery/**",
    ".designkit-history-delivery/**"
  ],

  "config": {
    "default": true,

    // 表格单元格内的换行在 GFM 里没有 Markdown 语法，只能写 <br>；
    // 测试矩阵、字段清单这类「一格多项」的表格用它表达换行是常态，GitHub 渲染一致。
    // 只放行 br 一个元素，其余内联 HTML 仍按 MD033 判红（历史上仓库没有任何其他 HTML 用法）。
    "MD033": {
      "allowed_elements": ["br"]
    },

    // ── 关闭：中文文风冲突（4 条）────────────────────────────────────────────

    // 行宽。默认 80，此处整条关闭（而非调成 120）——实测即便排除表格与代码块，
    // 仍有 309 行超过 120 字符，且集中在 CONTRIBUTING / CHANGELOG / ROADMAP 这类
    // 「一段一行 + 行内代码密集」的中文正文里。两个原因：
    //   1. 中文按字符计数，120 字符 ≈ 240 列，字符数在这里本来就不是视觉宽度；
    //   2. 硬折行会让「改一个词」变成跨行 diff，review 时看不出改了哪句。
    // .editorconfig 的 max_line_length = 120 管的是代码（ktlint/IDE 折行），
    // md 段落不适用——那里已经为 md 单独放开了 trim_trailing_whitespace，同一处立场。
    // 要启用：先统一文风为「按 120 列硬折行」，再打开并把 line_length 设为 120。
    "MD013": false,

    // 有序列表编号。默认期望每个列表从 1 开始（1/1/1）；本仓库的来源台账类文档
    // （DESIGN-AD-PAIN-RESEARCH.md，39 处）用「连续编号 + 加粗分组标题」表达
    // 「按首次出现顺序逐条核对」的语义：分组行把 markdown 列表切断成多段，
    // 每段从 8、15、22… 续编，渲染时靠 <ol start> 保持连续。
    // 改成 1/1/1 会得到「每组都从 1 开始」的错误编号，改成真标题又会丢掉连续编号，
    // 两者都比现状差。要启用：把分组标题改成 ### 并接受每组重新编号。
    "MD029": false,

    // 裸 URL。默认要求写成 <https://…>；实测 52 处全部是来源清单里的裸链接，
    // 多数在表格单元格内。加尖括号只改变渲染（变成带下划线的链接），
    // 不改语义，却让长 URL 在表格里更难核对——这类文档的价值恰恰在「URL 一眼可读」。
    "MD034": false,

    // 加粗当标题。默认禁止 **加粗** 独占一行；实测 36 处是中文小节的引导语
    // （「症状一：…」「① 跳过链路（客户端内，最高频）」），处在 h3 之下、
    // 用来分组段落而非充当章节。转成 h4 会把它们塞进 TOC，反而稀释目录。
    "MD036": false,

    // ── 关闭：纯观感（1 条）──────────────────────────────────────────────────

    // 表格列风格。默认要求同一张表的分隔行与单元格风格一致；本仓库统一是
    // 「单元格补空格（| a | b |）+ 分隔行紧凑（|---|---|）」，实测 309 处不满足
    // 任何单一风格（compact 要求 | --- |，tight 要求 |a|b|）。
    // 这种混写在 GitHub 上渲染完全一致，属纯观感；为它改 309 行分隔行不值得。
    // 要启用：设 "MD060": { "style": "compact" } 后跑 markdownlint-cli2 --fix，
    // 会把分隔行统一补成 | --- |（309 行，纯空白变更）。
    "MD060": false
  }
}
